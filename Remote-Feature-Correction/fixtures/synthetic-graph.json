  "_expectations": {
    "VolumeUp hard key (activity)": "sends buttonKey VolumeUp; hub runs TV VolumeUp (IR)",
    "Tap 'Lamp' (activity soft, index 0)": "sends indexInMenu 0; hub runs HA toggle; a hold >= 300 ms repeats it (P11)",
    "Tap 'Movie mode' (index 1)": "sends indexInMenu 1; hub runs sequence: HA script, 1 s, TV InputHdmi1; Touch blocks keys until sequenceFinished",
    "Tap '123' (index 2, FGT 36)": "Touch-local: opens the number pad; nothing sent; not stored on the hub",
    "Number pad '1' (FGT 2, index 0)": "sends fire, indexInMenu 0, functionGroupType 2; hub runs TV '1'; no clash with 'Lamp' (separate index space)",
    "SwipeUp": "Touch looks up VolumeUp in 16417Device90000010 (hard button) and sends buttonKey VolumeUp + deviceId 90000010; passes the activity hard-key gate because the activity maps VolumeUp",
    "Lamp device screen VolumeUp": "sends buttonKey VolumeUp + deviceId 90000020; hub runs HA brightness_up",
    "Activity start": "TV PowerOn, TV InputHdmi1; HA lamp NOT powered (not a member); HA script not powered (PowerTypeId 0 and not a member)",
    "Validator": "passes the hub validateGraph rules; 16414 Number1 is FGT 2 (16414-only, as Logitech data)"
