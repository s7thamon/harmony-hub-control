<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Hubs are LAN-only appliances serving HTTP on :8080 and HBus WS on :8088 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
